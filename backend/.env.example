# Copy this file to .env and adjust as needed.

# Database (Postgres, matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://solar:solar@localhost:5432/solar_tracker

# JWT
SECRET_KEY=change-me-to-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated list is NOT supported by pydantic-settings' list
# parsing from .env directly; if you need to change this, edit config.py's
# default or set CORS_ORIGINS as a JSON array string, e.g.:
# CORS_ORIGINS=["http://localhost:5173"]

# Used by scripts/seed.py and simulate_esp32.py
SIMULATOR_DEVICE_NAME=sim-esp32-01
